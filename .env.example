# Example .env for the multi-token runner
# Place this file at the repository root as .env (do NOT commit real tokens)

# The guild (server) ID where all channels live
GUILD_ID=123456789012345678

# Path to tokens file (default tokens.txt)
TOKENS_FILE=tokens.txt

# Where to persist browser profiles
PROFILES_DIR=profiles

# Concurrency: number of browser instances to run in parallel. Set 0 for "all".
CONCURRENCY=4

# How many rounds (commands) to run per account by default. Increase as needed.
ROUNDS_PER_ACCOUNT=10

# Logging
LOG_FILE=multi_token_runner.log

# Game behavior (optional overrides)
INITIAL_BET=10
BET_MULTIPLIER=2.0
COMMAND_INTERVAL=20
COMMAND_POST_RESPONSE_DELAY=1.5
